<?xml version="1.0" encoding="utf-8"?>
<!-- Debug では LAN 上の開発サーバーを検証できるよう平文通信を許可する。配布には使用しない。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
