<?xml version="1.0" encoding="utf-8"?>
<!-- Release では平文通信を許可しない。Debug 用の設定は build type のリソースで上書きする。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
