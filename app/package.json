{
    "name": "tonarice",
    "version": "1.0.0",
    "main": "dist-electron/main.cjs",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev-nuxt.js",
        "dev:remote": "node scripts/dev-nuxt.js --host 0.0.0.0",
        "dev:electron": "node scripts/dev-electron.js",
        "build": "tsup && nuxt build",
        "lint": "biome lint . --diagnostic-level=error",
        "preview": "nuxt preview",
        "preview:remote": "nuxt preview --host 0.0.0.0",
        "test": "vitest run",
        "test:mastra:live": "node scripts/run-mastra-live-tests.js",
        "test:browser": "vitest run --config vitest.browser.config.ts",
        "test:browser:watch": "vitest --config vitest.browser.config.ts",
        "typecheck": "vue-tsc --project tsconfig.json --noEmit",
        "typecheck:electron": "tsc --project tsconfig.electron.json --noEmit",
        "typecheck:all": "npm run typecheck && npm run typecheck:electron",
        "kill": "node scripts/kill-dev.js",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@ai-sdk/google": "4.0.121",
        "@ai-sdk/openai": "4.0.118",
        "@formkit/drag-and-drop": "^0.6.1",
        "@imgly/background-removal-node": "1.4.5",
        "@lmstudio/sdk": "2.1.0",
        "@mastra/core": "1.83.0",
        "@mastra/libsql": "1.30.0",
        "@mastra/memory": "1.41.1",
        "@primevue/themes": "^4.0.0",
        "@types/js-yaml": "^4.0.9",
        "ai": "7.0.173",
        "better-sqlite3": "^13.0.3",
        "esbuild": "^0.28.2",
        "express": "^4.22.3",
        "js-yaml": "^4.3.1",
        "pinia": "^4.1.0",
        "pixi.js": "^8.19.0",
        "primeflex": "^4.0.0",
        "primeicons": "^7.0.0",
        "primevue": "^4.0.0",
        "vue": "^3.5.45",
        "vue-draggable-plus": "^0.6.1",
        "ws": "^8.21.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.7",
        "@nuxtjs/tailwindcss": "6.14.0",
        "@pinia/nuxt": "^1.0.3",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "26.6.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/browser-playwright": "5.1.0",
        "@vue/test-utils": "~2.5.1",
        "autoprefixer": "^10.5.4",
        "canvas": "^3.2.3",
        "electron": "45.3.3",
        "electron-builder": "^26.18.0",
        "happy-dom": "^21.0.4",
        "jsdom": "^29.1.1",
        "nuxt": "4.6.4",
        "patch-package": "^8.0.1",
        "playwright": "1.65.1",
        "postcss": "^8.5.26",
        "tailwindcss": "^3.4.19",
        "tsup": "^9.0.0",
        "typescript": "~6.0.3",
        "vite": "~8.3.8",
        "vitest": "5.1.0",
        "vitest-browser-vue": "3.1.0",
        "vue-tsc": "3.3.14"
    },
    "engines": {
        "node": "^26.13.1"
    },
    "overrides": {
        "@imgly/background-removal-node": {
            "sharp": "0.35.5",
            "lodash": "^4.18.1",
            "zod": "$zod"
        },
        "app-builder-lib": {
            "@electron/universal": "^3.0.6",
            "minimatch": "^11.0.8"
        },
        "archiver": {
            "readdir-glob": "^4.0.0"
        },
        "js-beautify": {
            "glob": "^14.0.6",
            "minimatch": "^11.0.8"
        },
        "editorconfig": {
            "minimatch": "^11.0.8"
        }
    }
}
